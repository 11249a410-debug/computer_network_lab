import socket
import subprocess
import platform
import re


def get_dns_servers():
    """Obtain DNS server IP addresses from system configuration."""
    system = platform.system()
    dns_servers = []

    try:
        if system == "Windows":
            result = subprocess.run(
                ["ipconfig", "/all"],
                capture_output=True,
                text=True,
                encoding="utf-8",
                errors="replace"
            )

            # Find IPv4 and IPv6 DNS server addresses
            for line in result.stdout.splitlines():
                if "DNS Servers" in line or (
                    dns_servers and line.startswith(" ")
                ):
                    addresses = re.findall(
                        r"(?<![\w.])(?:\d{1,3}\.){3}\d{1,3}"
                        r"|[0-9a-fA-F:]*:[0-9a-fA-F:]+",
                        line
                    )
                    for address in addresses:
                        if address not in dns_servers:
                            dns_servers.append(address)

        elif system == "Linux":
            # Read DNS server entries from resolv.conf
            with open("/etc/resolv.conf", "r") as file:
                for line in file:
                    line = line.strip()
                    if line.startswith("nameserver"):
                        parts = line.split()
                        if len(parts) > 1:
                            address = parts[1]
                            if address not in dns_servers:
                                dns_servers.append(address)

        elif system == "Darwin":
            result = subprocess.run(
                ["scutil", "--dns"],
                capture_output=True,
                text=True,
                errors="replace"
            )

            for line in result.stdout.splitlines():
                match = re.search(
                    r"nameserver\[\d+\]\s*:\s*(\S+)", line
                )
                if match:
                    address = match.group(1)
                    if address not in dns_servers:
                        dns_servers.append(address)

    except (OSError, subprocess.SubprocessError) as error:
        print("Error reading DNS configuration:", error)

    return dns_servers


def get_dns_hostname(ip_address):
    """Attempt a reverse DNS lookup for the DNS server IP."""
    try:
        hostname, aliases, addresses = socket.gethostbyaddr(ip_address)
        return hostname
    except (socket.herror, socket.gaierror, OSError):
        return "Hostname not available (reverse DNS lookup failed)"


def main():
    print("======================================")
    print(" LOCAL DNS SERVER INFORMATION")
    print("======================================")

    dns_servers = get_dns_servers()

    if not dns_servers:
        print("No DNS server addresses found.")
        print("Check your network DNS configuration.")
        return

    for number, ip_address in enumerate(dns_servers, start=1):
        print(f"\nDNS Server {number}")
        print("IP Address :", ip_address)
        print("Host Name  :", get_dns_hostname(ip_address))

    print("\n======================================")


if __name__ == "__main__":
    main()
